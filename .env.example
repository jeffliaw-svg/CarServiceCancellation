# RefundRoute API server -- environment variables.
# Copy to ".env" on your host and fill in real values. Do not commit .env.

# Where case data and generated files are stored. On a hosted server,
# point this at a persistent disk/volume so cases survive restarts and
# redeploys.
REFUNDS_DATA_DIR=./server/_data

# The browser origin(s) allowed to call this API, for CORS. Required when
# the front-end (e.g. Vercel) and this API run on different hosts.
#   - one origin:        https://your-frontend.vercel.app
#   - several:           https://a.vercel.app,https://b.vercel.app
#   - any origin:        *   (acceptable for a closed beta -- the access
#                             code and per-case tokens are the real gate)
REFUNDS_ALLOWED_ORIGIN=https://your-frontend.vercel.app

# Closed-beta gate: anyone starting a claim must supply this code.
# Leave blank to disable the gate (fully open access).
REFUNDS_ACCESS_CODE=

# Document-reading model keys. Set at least one to read scanned
# contracts; set both for cross-vendor extraction redundancy.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# PORT is normally provided by the host; it defaults to 8000 locally.
# PORT=8000
